<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Internet somente para baixar modelos. Inferencia e historico permanecem locais. -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <application
      android:allowBackup="false"
      android:label="Nexora"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher"
      android:theme="@style/Theme.Nexora"
      android:supportsRtl="true"
      android:usesCleartextTraffic="false">
      <activity android:name=".SettingsActivity" android:exported="false"/>
      <activity android:name=".ThemeActivity" android:exported="false"/>
      <activity android:name=".ChatActivity" android:exported="false"/>
      <activity android:name=".ModelCatalogActivity" android:exported="false"/>
      <activity
          android:name=".MainActivity"
          android:exported="true"
          android:configChanges="orientation|screenSize|keyboardHidden">
          <intent-filter>
              <action android:name="android.intent.action.MAIN"/>
              <category android:name="android.intent.category.LAUNCHER"/>
          </intent-filter>
      </activity>
  </application>
</manifest>
