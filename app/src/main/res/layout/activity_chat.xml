<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/uiSurface" android:paddingStart="16dp" android:paddingEnd="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="10dp">
  <ImageButton android:id="@+id/backChat" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:tint="?attr/uiLabel" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar às conversas"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="6dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/chatHeading" android:text="Conversa" android:textColor="?attr/uiLabel" android:textSize="23sp" android:textStyle="bold"/>
   <TextView android:id="@+id/chatModelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="middle" android:text="Modelo" android:textColor="?attr/uiAccent" android:textSize="12sp"/>
  </LinearLayout>
  <ImageButton android:id="@+id/exportChat" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_export" android:tint="?attr/uiMuted" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Exportar conversa e diagnóstico"/>
  <ImageButton android:id="@+id/clearChat" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_clear_chat" android:tint="?attr/uiMuted" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Limpar histórico"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="●  IA LOCAL ATIVA" android:textColor="?attr/uiAccent" android:textSize="11sp" android:layout_marginBottom="10dp" android:letterSpacing="0.1"/>
 <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="7dp" app:cardBackgroundColor="?attr/uiPanel" app:cardCornerRadius="17dp" app:cardElevation="0dp" app:strokeColor="?attr/uiBorder" app:strokeWidth="1dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="13dp" android:paddingEnd="13dp" android:paddingTop="8dp" android:paddingBottom="10dp">
   <LinearLayout android:id="@+id/performanceHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="Expandir ou minimizar desempenho local">
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="◈  DESEMPENHO LOCAL" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.09" android:textColor="?attr/uiAccent"/>
    <TextView android:id="@+id/performanceTitleStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:text="Em espera" android:textSize="11sp" android:textColor="?attr/uiMuted"/>
    <TextView android:id="@+id/performanceMinimize" android:layout_width="40dp" android:layout_height="42dp" android:gravity="center" android:text="−" android:textSize="23sp" android:textColor="?attr/uiLabel" android:contentDescription="Minimizar painel de desempenho" android:background="?attr/selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true"/>
    <TextView android:id="@+id/performanceToggle" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center" android:text="⌄" android:textSize="24sp" android:textColor="?attr/uiLabel" android:contentDescription="Expandir informações de desempenho" android:background="?attr/selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true"/>
   </LinearLayout>
   <LinearLayout android:id="@+id/performanceOverview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="2dp" android:gravity="top">
    <LinearLayout android:layout_width="0dp" android:layout_weight="1.35" android:layout_height="wrap_content" android:orientation="vertical">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="⚡ Velocidade" android:textSize="10sp" android:textColor="?attr/uiMuted"/>
     <TextView android:id="@+id/performanceSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/uiLabel"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="▣ Nexora PSS" android:textSize="10sp" android:textColor="?attr/uiMuted"/>
     <TextView android:id="@+id/performancePss" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/uiLabel"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="6dp">
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="♨ Bateria" android:textSize="10sp" android:textColor="?attr/uiMuted"/>
     <TextView android:id="@+id/performanceBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="—" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/uiLabel"/>
    </LinearLayout>
   </LinearLayout>
   <ProgressBar android:id="@+id/performanceGauge" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="8dp" android:visibility="gone" android:indeterminate="true" android:indeterminateTint="?attr/uiAccent" android:progressTint="?attr/uiAccent"/>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/performanceRamLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="RAM disponível: —" android:textSize="11sp" android:textColor="?attr/uiMuted"/>
    <TextView android:id="@+id/performanceThermalSummary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Android: —" android:textSize="11sp" android:textColor="?attr/uiMuted"/>
   </LinearLayout>
   <ProgressBar android:id="@+id/performanceRamBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" android:max="100"/>
   <LinearLayout android:id="@+id/performanceRamSegments" android:layout_width="match_parent" android:layout_height="25dp" android:layout_marginTop="7dp" android:orientation="horizontal" android:background="?attr/uiBorder" />
   <LinearLayout android:id="@+id/performanceDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="9dp" android:layout_marginBottom="8dp" android:background="?attr/uiBorder"/>
    <TextView android:id="@+id/performanceLatency" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Primeiro fragmento: —" android:textColor="?attr/uiLabel" android:textSize="11sp"/>
    <TextView android:id="@+id/performanceGrade" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tokens: —" android:textColor="?attr/uiLabel" android:textSize="11sp"/>
    <TextView android:id="@+id/performanceMemory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Memória: —" android:textColor="?attr/uiMuted" android:textSize="11sp"/>
    <TextView android:id="@+id/performanceThermal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Estado térmico do Android: —" android:textColor="?attr/uiMuted" android:textSize="11sp"/>
    <TextView android:id="@+id/performanceCpu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="CPU Nexora: —" android:textColor="?attr/uiMuted" android:textSize="11sp"/>
    <TextView android:id="@+id/performanceModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Modelo: —" android:textColor="?attr/uiMuted" android:textSize="11sp"/>
    <TextView android:id="@+id/performanceNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Métricas nativas aparecem após a geração." android:textColor="?attr/uiMuted" android:textSize="10sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Temperatura é da bateria. Estado térmico vem do Android; não é temperatura da CPU." android:textColor="?attr/uiMuted" android:textSize="10sp"/>
   </LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipToPadding="false"/>

 <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
  <LinearLayout android:id="@+id/pdfAttachments" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
 </HorizontalScrollView>
 <TextView android:id="@+id/stateLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="Modelo pronto para conversar." android:textColor="?attr/uiMuted" android:textSize="12sp" android:maxLines="2"/>
 <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/uiPanel" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="?attr/uiBorder" app:strokeWidth="1dp" android:layout_marginBottom="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom|center_vertical" android:padding="6dp">
   <ImageButton android:id="@+id/attachPdf" android:layout_width="42dp" android:layout_height="50dp" android:padding="9dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_attach" android:tint="?attr/uiLabel" android:contentDescription="Anexar PDF"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/thinkMode" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="50dp" android:minWidth="0dp" android:text="Direto" android:textAllCaps="false" android:textSize="11sp" android:paddingStart="8dp" android:paddingEnd="8dp" app:icon="@drawable/ic_brain" app:iconSize="18dp" app:iconPadding="3dp"/>
   <EditText android:id="@+id/promptInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minHeight="48dp" android:gravity="center_vertical" android:padding="8dp" android:background="@android:color/transparent" android:hint="Pergunte à Nexora..." android:textColor="?attr/uiLabel" android:textColorHint="?attr/uiMuted" android:inputType="textCapSentences|textMultiLine" android:minLines="1" android:maxLines="4" android:textSize="14sp"/>
   <ImageButton android:id="@+id/sendMessage" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_send" android:tint="?attr/uiSurface" android:padding="13dp" android:background="@drawable/bg_send" android:contentDescription="Enviar mensagem" />
   <com.google.android.material.button.MaterialButton android:id="@+id/stopGeneration" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="50dp" android:visibility="gone" android:text="Parar" android:textAllCaps="false" android:textSize="12sp"/>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
</LinearLayout>
