<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/uiSurface" android:paddingStart="16dp" android:paddingEnd="16dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="12dp" android:paddingBottom="10dp">
  <ImageButton android:id="@+id/backChat" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:tint="?attr/uiLabel" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar aos modelos"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="6dp">
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conversar" android:textColor="?attr/uiLabel" android:textSize="23sp" android:textStyle="bold"/>
   <TextView android:id="@+id/chatModelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="middle" android:text="Modelo" android:textColor="?attr/uiAccent" android:textSize="12sp"/>
  </LinearLayout>
  <ImageButton android:id="@+id/clearChat" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_clear_chat" android:tint="?attr/uiMuted" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Limpar histórico"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="●  IA LOCAL ATIVA" android:textColor="?attr/uiAccent" android:textSize="11sp" android:layout_marginBottom="10dp" android:letterSpacing="0.1"/>
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/messages" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingTop="8dp" android:paddingBottom="8dp" android:clipToPadding="false"/>
 <TextView android:id="@+id/stateLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="Modelo pronto para conversar." android:textColor="?attr/uiMuted" android:textSize="12sp" android:maxLines="2"/>
 <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="?attr/uiPanel" app:cardCornerRadius="24dp" app:cardElevation="0dp" app:strokeColor="?attr/uiBorder" app:strokeWidth="1dp" android:layout_marginBottom="10dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom|center_vertical" android:padding="6dp">
   <com.google.android.material.button.MaterialButton android:id="@+id/thinkMode" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="50dp" android:minWidth="0dp" android:text="Direto" android:textAllCaps="false" android:textSize="11sp" android:paddingStart="8dp" android:paddingEnd="8dp" app:icon="@drawable/ic_brain" app:iconSize="18dp" app:iconPadding="3dp"/>
   <EditText android:id="@+id/promptInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minHeight="48dp" android:gravity="center_vertical" android:padding="8dp" android:background="@android:color/transparent" android:hint="Pergunte à Nexora..." android:textColor="?attr/uiLabel" android:textColorHint="?attr/uiMuted" android:inputType="textCapSentences|textMultiLine" android:minLines="1" android:maxLines="4" android:textSize="14sp"/>
   <ImageButton android:id="@+id/sendMessage" android:layout_width="50dp" android:layout_height="50dp" android:src="@drawable/ic_send" android:tint="?attr/uiSurface" android:padding="13dp" android:background="@drawable/bg_send" android:contentDescription="Enviar mensagem" />
   <com.google.android.material.button.MaterialButton android:id="@+id/stopGeneration" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="50dp" android:visibility="gone" android:text="Parar" android:textAllCaps="false" android:textSize="12sp"/>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
</LinearLayout>
