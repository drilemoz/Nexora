<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
 <LinearLayout android:id="@+id/conversationSectionRow" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="7dp">
  <TextView android:id="@+id/conversationSection" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="HOJE" android:textColor="?attr/uiMuted" android:textSize="12sp" android:letterSpacing="0.06" android:maxLines="1" android:ellipsize="end"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/historySelectMode" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:minHeight="40dp" app:insetTop="0dp" app:insetBottom="0dp" android:layout_marginEnd="6dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center" android:text="Selecionar" android:textColor="?attr/uiAccent" android:textSize="11sp" app:strokeColor="?attr/uiBorder" app:cornerRadius="13dp" android:contentDescription="Selecionar várias conversas"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/historySelectAll" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="0dp" android:minHeight="40dp" app:insetTop="0dp" app:insetBottom="0dp" android:layout_marginEnd="4dp" android:paddingStart="9dp" android:paddingEnd="9dp" android:gravity="center" android:text="Todas" android:textColor="?attr/uiAccent" android:textSize="11sp" app:strokeColor="?attr/uiBorder" app:cornerRadius="13dp" android:visibility="gone" android:contentDescription="Selecionar todas as conversas exibidas"/>
  <ImageButton android:id="@+id/historyBulkDelete" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_delete" android:tint="?attr/uiMuted" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Excluir todas as conversas"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="11dp" android:paddingBottom="11dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="?attr/selectableItemBackground">
  <CheckBox android:id="@+id/conversationSelected" android:layout_width="48dp" android:layout_height="48dp" android:buttonTint="?attr/uiAccent" android:gravity="center" android:clickable="false" android:focusable="false" android:visibility="gone" android:contentDescription="Conversa selecionada"/>
  <ImageView android:id="@+id/conversationIcon" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/uiPanel" android:src="@drawable/ic_message" android:padding="12dp" android:tint="?attr/uiLabel" android:contentDescription="Conversa"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="14dp">
   <TextView android:id="@+id/conversationTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:maxLines="2" android:ellipsize="end" android:textColor="?attr/uiLabel"/>
   <TextView android:id="@+id/conversationModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:textColor="?attr/uiMuted"/>
  </LinearLayout>
  <ImageButton android:id="@+id/conversationMenu" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_more" android:tint="?attr/uiMuted" android:contentDescription="Opções da conversa"/>
 </LinearLayout>
</LinearLayout>
