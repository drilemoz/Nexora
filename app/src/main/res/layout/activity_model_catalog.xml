<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="?attr/uiSurface" android:paddingStart="18dp" android:paddingEnd="18dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="18dp">
  <ImageButton android:id="@+id/backCatalog" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:tint="?attr/uiLabel" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar aos modelos"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Explorar modelos" android:textSize="23sp" android:textStyle="bold" android:textColor="?attr/uiLabel" android:layout_marginStart="4dp"/>
 </LinearLayout>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CATÁLOGO GGUF" android:letterSpacing="0.13" android:textStyle="bold" android:textSize="11sp" android:textColor="?attr/uiAccent"/>
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modelos leves e locais. Internet somente para baixar." android:textSize="13sp" android:textColor="?attr/uiMuted" android:layout_marginTop="6dp" android:layout_marginBottom="14dp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <EditText android:id="@+id/catalogSearch" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:hint="Pesquisar GGUF" android:singleLine="true" android:inputType="text" android:textSize="13sp" android:textColor="?attr/uiLabel" android:textColorHint="?attr/uiMuted" android:backgroundTint="?attr/uiBorder"/>
  <Spinner android:id="@+id/catalogSort" android:layout_width="140dp" android:layout_height="48dp" android:contentDescription="Ordenação dos modelos"/>
 </LinearLayout>
 <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="false"><LinearLayout android:id="@+id/catalogCards" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp"/></ScrollView>
 <com.google.android.material.card.MaterialCardView android:id="@+id/downloadPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginBottom="14dp" app:cardBackgroundColor="?attr/uiPanel" app:cardCornerRadius="22dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="?attr/uiBorder">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
   <TextView android:id="@+id/downloadTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Download em andamento" android:textColor="?attr/uiLabel" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
   <TextView android:id="@+id/downloadStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Preparando transferência" android:textColor="?attr/uiMuted" android:textSize="13sp" android:layout_marginTop="7dp"/>
   <ProgressBar android:id="@+id/downloadProgress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="9dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressTint="?attr/uiAccent" android:progressBackgroundTint="?attr/uiBorder"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/cancelDownload" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cancelar transferência" android:textAllCaps="false" android:layout_marginTop="13dp"/>
  </LinearLayout>
 </com.google.android.material.card.MaterialCardView>
</LinearLayout>
