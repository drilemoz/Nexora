<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="?attr/uiSurface">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="26dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingTop="12dp" android:paddingBottom="12dp">
   <ImageButton android:id="@+id/backFromCompatibility" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:tint="?attr/uiLabel" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Voltar"/>
   <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Compatibilidade dos modelos" android:textSize="21sp" android:textStyle="bold" android:textColor="?attr/uiLabel" android:layout_marginStart="6dp"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INSPEÇÃO DO MODELO ATIVO" android:textStyle="bold" android:textColor="?attr/uiAccent" android:textSize="12sp" android:letterSpacing="0.12" android:paddingBottom="10dp"/>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="?attr/uiBorder" app:cardBackgroundColor="?attr/uiPanel">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modelo ativo" android:textStyle="bold" android:textSize="13sp" android:textColor="?attr/uiMuted"/>
    <TextView android:id="@+id/templateModel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nenhum GGUF" android:textIsSelectable="true" android:layout_marginTop="4dp" android:textSize="15sp" android:textColor="?attr/uiLabel"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chat Template" android:textStyle="bold" android:textSize="13sp" android:textColor="?attr/uiMuted" android:layout_marginTop="14dp"/>
    <TextView android:id="@+id/templateName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Não verificado" android:layout_marginTop="4dp" android:textColor="?attr/uiLabel" android:textSize="15sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Origem" android:textStyle="bold" android:textSize="13sp" android:textColor="?attr/uiMuted" android:layout_marginTop="14dp"/>
    <TextView android:id="@+id/templateOrigin" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Não verificado" android:layout_marginTop="4dp" android:textColor="?attr/uiLabel" android:textSize="15sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aplicação" android:textStyle="bold" android:textSize="13sp" android:textColor="?attr/uiMuted" android:layout_marginTop="14dp"/>
    <TextView android:id="@+id/templateApplication" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Não verificado" android:layout_marginTop="4dp" android:textColor="?attr/uiLabel" android:textSize="15sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Motor" android:textStyle="bold" android:textSize="13sp" android:textColor="?attr/uiMuted" android:layout_marginTop="14dp"/>
    <TextView android:id="@+id/templateEngine" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="llama.cpp (revisão fixada)" android:layout_marginTop="4dp" android:textColor="?attr/uiLabel" android:textSize="15sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Compatibilidade" android:textStyle="bold" android:textSize="13sp" android:textColor="?attr/uiMuted" android:layout_marginTop="14dp"/>
    <TextView android:id="@+id/templateCompatibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Carregue um GGUF para verificar" android:layout_marginTop="4dp" android:textColor="?attr/uiLabel" android:textSize="14sp"/>
    <TextView android:id="@+id/templateReasoning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="?attr/uiMuted" android:textSize="12sp"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
   <Button android:id="@+id/verifyTemplateButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Verificar template" android:textAllCaps="false" android:contentDescription="Validar formatação e tokenização do modelo sem gerar resposta"/>
   <Button android:id="@+id/copyTemplateButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Copiar diagnóstico" android:textAllCaps="false" android:layout_marginStart="8dp"/>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CONFIGURAÇÃO DO TEMPLATE" android:textColor="?attr/uiAccent" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" android:layout_marginTop="22dp" android:layout_marginBottom="9dp"/>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="?attr/uiBorder" app:cardBackgroundColor="?attr/uiPanel">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
    <RadioButton android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Automático (recomendado)" android:textColor="?attr/uiLabel" android:checked="true" android:clickable="false" android:focusable="false"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Aplica somente o template do próprio GGUF, se suportado e validado. Não usa outro modelo como fallback." android:layout_marginStart="34dp" android:textColor="?attr/uiMuted" android:textSize="12sp"/>
    <RadioButton android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Personalizado (avançado)" android:textColor="?attr/uiMuted" android:enabled="false" android:layout_marginTop="13dp"/>
    <TextView android:id="@+id/customTemplateNotice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="34dp" android:textSize="12sp" android:textColor="?attr/uiMuted"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
 </LinearLayout>
</ScrollView>
